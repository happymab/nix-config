# Set shell to bash for reliable execution
set shell := ["bash", "-uc"]

# Default recipe: show available commands
@default:
    just --global-justfile --list

## ==========================================================
## NixOS Management
## ==========================================================

# Update NixOS flake
[group('NixOS')]
update:
    nix flake update

# Rebuild NixOS configuration with build option (default is nixos-rebuild switch)
[group('NixOS')]
rebuild build-option='switch':
    git add -A
    nh os {{ build-option }} .

# Rollback to the previous system generation
[group('NixOS')]
rollback:
    nh os rollback

# Rollback to the specified system generation
[group('NixOS')]
rollback-to generation:
    nh os rollback --to {{ generation }}

# List generations
[group('NixOS')]
builds:
    nh os info

# Remove generations
[group('NixOS')]
rm-builds +g=('+30d'):
    sudo nix-env -p /nix/var/nix/profiles/system --delete-generations {{ g }}

# Cleanup and optimize the Nix store
[group('NixOS')]
cleanup:
    sudo nix-collect-garbage
    sudo nix-store --optimise

## ==========================================================
## Linux Recepies
## ==========================================================

# Shutdown the system
[group('Linux')]
off:
    systemctl poweroff

# Reboot the system
[group('Linux')]
reboot:
    systemctl reboot

# Show system log for specific startup (default current startup)
[group('Linux')]
logs startup='0':
    journalctl -xb {{ startup }}

# Show system log for specific unit, show n entries (default 100)
[group('Linux')]
ulogs unit n='100':
    journalctl -x -n {{ n }} -u {{ unit }}

# Show current IP configuration
[group('Network')]
net:
    ip addr show
    ip route

# Show listening ports
[group('Network')]
ports:
    ss -tulnp
