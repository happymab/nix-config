# Set shell to bash for reliable execution
set shell := ["bash", "-uc"]

# Default recipe: show available commands
@default:
    just --global-justfile --list

## ==========================================================
## NixOS Management
## ==========================================================

# Rebuild NixOS configuration with build option (default is nixos-rebuild switch)
[group('NixOS')]
rebuild build-option='switch':
    git add -A
    sudo nixos-rebuild {{build-option}} --flake .#

# Rollback to the previous system generation
[group('NixOS')]
rollback:
    sudo nixos-rebuild switch --rollback

# List generations
[group('NixOS')]
builds:
    sudo nixos-rebuild list-generations

# Cleanup and optimize the Nix store
[group('NixOS')]
cleanup:
    sudo nix-collect-garbage
    sudo nix-store --optimise

## ==========================================================
## Linux Recepies
## ==========================================================

# Shutdown the system
[group('Linux')]
off:
    systemctl poweroff

# Reboot the system
[group('Linux')]
reboot:
    systemctl reboot

# Show system log for specific startup (default current startup)
[group('Linux')]
logs startup='0':
    sudo journalctl -xb {{startup}}

# Show system log for specific unit, show n entries (default 100)
[group('Linux')]
ulogs unit n='100':
    sudo journalctl -x -n {{n}} -u {{unit}}

# Show current IP configuration
[group('Network')]
net:
    ip addr show
    ip route

# Show listening ports
[group('Network')]
ports:
    ss -tulnp