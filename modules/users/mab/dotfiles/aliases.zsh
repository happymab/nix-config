# ====== General ======
alias ll='ls -l'
alias la='ls -lah'
alias l='ls -lah | less'
alias c='clear'
alias e='exit'
alias mkdir='mkdir -pv'
alias less='less -R'

# ====== Git ======
alias gs='git status'
alias gp='git push'
alias gpl='git pull'
alias gc='git commit -m'
alias gad='git add'
alias gd='git diff'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gcm='git checkout master'
alias gm='git merge'
alias gl='git log --oneline --graph --decorate'

# ====== System ======
alias h='history'
alias j='jobs -l'
